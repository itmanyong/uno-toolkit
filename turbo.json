{
  "$schema": "./node_modules/turbo/schema.json",
  "globalEnv": ["NODE_ENV", "UNO_ORCHESTRATION_ENV"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "doc_build/**"]
    },
    "preview": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "lint": {
      "outputs": []
    },
    "fmt": {
      "cache": false
    },
    "doc": {
      "dependsOn": ["^build"],
      "outputs": ["doc_build/**"]
    }
  }
}
