{
  "name": "uno-toolkit",
  "private": true,
  "type": "module",
  "description": "Uno Toolkit 的 monorepo 根工作区",
  "keywords": [
    "monorepo",
    "toolkit",
    "rsbuild",
    "vite",
    "plugin",
    "jsx-directive",
    "signals",
    "css-cascade-layers",
    "rspress",
    "docs"
  ],
  "author": "itmanyong <itmanyong@gmail.com>",
  "contributors": [
    "itmanyong <itmanyong@gmail.com>"
  ],
  "license": "ISC",
  "homepage": "https://github.com/itmanyong/uno-toolkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itmanyong/uno-toolkit.git",
    "directory": "."
  },
  "bugs": {
    "url": "https://github.com/itmanyong/uno-toolkit/issues"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "turbo": "turbo",
    "dev": "turbo dev",
    "build": "turbo build",
    "preview": "turbo preview",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "format": "turbo fmt",
    "check": "turbo typecheck lint",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "release": "changeset publish",
    "release:ci": "changeset version && changeset publish"
  },
  "dependencies": {},
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "rstack": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "volta": {
    "node": "24.22.1",
    "pnpm": "12.15.0"
  },
  "packageManager": "pnpm@12.15.0"
}
