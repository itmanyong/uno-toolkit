{
  "name": "@uno-pc/reactivue",
  "version": "0.0.1",
  "description": "Vue 3 composition API on React with Vue reactivity, compile-time JSX block splitting and zero-rerender text bindings.",
  "keywords": [
    "react",
    "vue",
    "reactivity",
    "composition-api",
    "signals",
    "jsx-transform",
    "rust",
    "napi",
    "vite",
    "rsbuild"
  ],
  "author": "itmanyong <itmanyong@gmail.com>",
  "contributors": [
    "itmanyong <itmanyong@gmail.com>"
  ],
  "license": "ISC",
  "homepage": "https://www.npmjs.com/package/@uno-pc/reactivue",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itmanyong/uno-toolkit.git",
    "directory": "packages/reactivue"
  },
  "bugs": {
    "url": "https://github.com/itmanyong/uno-toolkit/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "native",
    "types",
    "README.md",
    "package.json"
  ],
  "types": "./types/global.d.ts",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/types/plugins/vite.d.ts",
      "development": "./src/plugins/vite.ts",
      "default": "./dist/plugins/vite.js"
    },
    "./rsbuild": {
      "types": "./dist/types/plugins/rsbuild.d.ts",
      "development": "./src/plugins/rsbuild.ts",
      "default": "./dist/plugins/rsbuild.js"
    },
    "./compat": {
      "types": "./dist/types/compat/index.d.ts",
      "development": "./src/compat/index.ts",
      "default": "./dist/compat/index.js"
    },
    "./internal": {
      "types": "./dist/types/internal/index.d.ts",
      "development": "./src/internal/index.ts",
      "default": "./dist/internal/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.js"
      },
      "./vite": {
        "types": "./dist/types/plugins/vite.d.ts",
        "default": "./dist/plugins/vite.js"
      },
      "./rsbuild": {
        "types": "./dist/types/plugins/rsbuild.d.ts",
        "default": "./dist/plugins/rsbuild.js"
      },
      "./compat": {
        "types": "./dist/types/compat/index.d.ts",
        "default": "./dist/compat/index.js"
      },
      "./internal": {
        "types": "./dist/types/internal/index.d.ts",
        "default": "./dist/internal/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "dev": "rs lib -w",
    "build": "pnpm build:native && rs lib",
    "build:native": "node scripts/build-native.mjs",
    "build:js": "rs lib",
    "test": "pnpm build:native && pnpm test:rust && rs test",
    "test:rust": "cargo test --offline --manifest-path native-rust/Cargo.toml",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "rs lint",
    "fmt": "rs fmt",
    "doc": "rs doc"
  },
  "peerDependencies": {
    "@rsbuild/core": ">=2.3.0 <3",
    "@vue/reactivity": ">=3.5",
    "react": ">=19",
    "react-dom": ">=19",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "@rsbuild/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rsbuild/core": "catalog:",
    "@rstest/coverage-istanbul": "^0.12.6",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vue/reactivity": "catalog:",
    "@vueuse/core": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rstack": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "dependencies": {
    "magic-string": "^1.4.5"
  }
}
