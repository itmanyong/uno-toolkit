{
  "name": "@uno-pc/signals-transform",
  "version": "0.0.1",
  "description": "Compile-time Preact Signals transformer — auto-injects `useSignals` and wraps effects in `try/finally` so signal tracking works without manual boilerplate, powered by a Rust + napi native module for Rsbuild & Vite.",
  "keywords": [
    "preact",
    "signals",
    "signals-react",
    "reactivity",
    "compiler",
    "rust",
    "napi",
    "rsbuild",
    "vite",
    "react",
    "transform",
    "compile-time"
  ],
  "author": "itmanyong <itmanyong@gmail.com>",
  "contributors": [
    "itmanyong <itmanyong@gmail.com>"
  ],
  "license": "ISC",
  "homepage": "https://github.com/itmanyong/uno-toolkit/tree/main/packages/signals-transform#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itmanyong/uno-toolkit.git",
    "directory": "packages/signals-transform"
  },
  "bugs": {
    "url": "https://github.com/itmanyong/uno-toolkit/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "native",
    "README.md",
    "package.json"
  ],
  "types": "./dist/types/index.d.ts",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/types/plugins/vite.d.ts",
      "development": "./src/plugins/vite.ts",
      "default": "./dist/plugins/vite.js"
    },
    "./rsbuild": {
      "types": "./dist/types/plugins/rsbuild.d.ts",
      "development": "./src/plugins/rsbuild.ts",
      "default": "./dist/plugins/rsbuild.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.js"
      },
      "./vite": {
        "types": "./dist/types/plugins/vite.d.ts",
        "default": "./dist/plugins/vite.js"
      },
      "./rsbuild": {
        "types": "./dist/types/plugins/rsbuild.d.ts",
        "default": "./dist/plugins/rsbuild.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "dev": "pnpm build:native && rs lib -w",
    "build": "pnpm build:native && rs lib",
    "build:native": "node scripts/build-native.mjs",
    "build:js": "rs lib",
    "test": "pnpm build:native && pnpm test:rust && rs test",
    "test:rust": "cargo test --manifest-path native-rust/Cargo.toml",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "rs lint",
    "fmt": "rs fmt"
  },
  "peerDependencies": {
    "@preact/signals-react": ">=3",
    "@rsbuild/core": ">=2.3.0 <3",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "@preact/signals-react": {
      "optional": true
    },
    "@rsbuild/core": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@preact/signals-react": "catalog:",
    "@rsbuild/core": "catalog:",
    "@types/node": "catalog:",
    "rstack": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
