{
  "name": "@uno-pc/jsx-directive",
  "version": "0.0.1",
  "description": "Compile-time React JSX directive transformer for v-if, v-for, v-show, v-html, v-text, v-bind and v-model, with Vite and Rsbuild plugins.",
  "keywords": [
    "jsx",
    "jsx-directives",
    "jsx-plugin",
    "directive",
    "v-if",
    "v-else",
    "v-else-if",
    "v-for",
    "v-show",
    "v-html",
    "v-text",
    "v-bind",
    "v-model",
    "control-flow",
    "jsx-transform",
    "compiler",
    "rust",
    "napi",
    "rsbuild",
    "vite",
    "react",
    "preact"
  ],
  "author": "itmanyong <itmanyong@gmail.com>",
  "contributors": [
    "itmanyong <itmanyong@gmail.com>"
  ],
  "license": "ISC",
  "homepage": "https://www.npmjs.com/package/@uno-pc/jsx-directive",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itmanyong/uno-toolkit.git",
    "directory": "packages/jsx-directive"
  },
  "bugs": {
    "url": "https://github.com/itmanyong/uno-toolkit/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "native",
    "types",
    "README.md",
    "package.json"
  ],
  "types": "./types/global.d.ts",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/types/plugins/vite.d.ts",
      "development": "./src/plugins/vite.ts",
      "default": "./dist/plugins/vite.js"
    },
    "./rsbuild": {
      "types": "./dist/types/plugins/rsbuild.d.ts",
      "development": "./src/plugins/rsbuild.ts",
      "default": "./dist/plugins/rsbuild.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.js"
      },
      "./vite": {
        "types": "./dist/types/plugins/vite.d.ts",
        "default": "./dist/plugins/vite.js"
      },
      "./rsbuild": {
        "types": "./dist/types/plugins/rsbuild.d.ts",
        "default": "./dist/plugins/rsbuild.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "dev": "pnpm build:native && rs lib -w",
    "build": "pnpm build:native && rs lib",
    "build:native": "node scripts/build-native.mjs",
    "build:js": "rs lib",
    "test": "pnpm build:native && pnpm test:rust && rs test",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test:rust": "cargo test --manifest-path native-rust/Cargo.toml",
    "doc": "rs doc",
    "lint": "rs lint",
    "fmt": "rs fmt"
  },
  "peerDependencies": {
    "@rsbuild/core": ">=2.3.0 <3",
    "@types/react": ">=18",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "@rsbuild/core": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rsbuild/core": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "rstack": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "dependencies": {
    "magic-string": "^1.4.5"
  }
}
