{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM"],
    "rootDir": "src",
    "types": ["node"],
    "strict": true,
    "noEmit": false,
    "declaration": true,
    "isolatedDeclarations": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true
  },
  "include": ["src", "types"],
  "exclude": ["node_modules", "**/dist"]
}
